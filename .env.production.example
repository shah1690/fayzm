# ============================================================================
# Fayzm — PRODUCTION environment template. Copy to .env on the server and fill
# the secrets. Domains:
#   https://fayzm.uz          → frontend (Next.js)
#   https://back.fayzm.uz     → backend  (Django API + admin)
#   https://media.fayzm.uz    → MinIO media (bucket root, public read)
#   https://minioinit.fayzm.uz→ MinIO console (admin UI, port 9001)
# TLS is terminated by the reverse proxy (Traefik/Nginx); Django trusts
# X-Forwarded-Proto.
# ============================================================================

TZ=Asia/Tashkent

# --- Django ----------------------------------------------------------------
SECRET_KEY=CHANGE-ME-to-a-long-random-50+char-value
DEBUG=False
ENABLE_HTTPS_REDIRECT=True
ALLOWED_HOSTS=back.fayzm.uz
BACKEND_URL=https://back.fayzm.uz
SECURE_HSTS_SECONDS=31536000

# --- CORS / CSRF -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://fayzm.uz
CSRF_TRUSTED_ORIGINS=https://back.fayzm.uz,https://fayzm.uz

# --- Frontend (build + runtime) --------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fayzm.uz
NEXT_PUBLIC_API_URL=https://back.fayzm.uz
# Server-side calls from Next -> backend. Use the internal service name if both
# run in the same Docker network, else the public backend URL.
BACKEND_INTERNAL_URL=http://backend:8000
MEDIA_PUBLIC_URL=https://media.fayzm.uz
# Origin of the frontend, used by the admin to preview frontend public assets.
FRONTEND_URL=https://fayzm.uz
TELEGRAM_BOT_TOKEN=your-production-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
AMOCRM_FORM_ID=1680078
AMOCRM_FORM_HASH=your-amocrm-form-hash

# --- PostgreSQL ------------------------------------------------------------
DB_NAME=fayzm_db
DB_USER=fayzm_user
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Channels ------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- API throttling / OTP --------------------------------------------------
DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour
DRF_THROTTLE_OTP=5/minute
SMS_BACKEND=console

# --- MinIO (media.fayzm.uz) ------------------------------------------------
USE_MINIO=True
# Public host that serves the bucket at its root (https://media.fayzm.uz/<key>).
MINIO_ENDPOINT=media.fayzm.uz
MINIO_CUSTOM_DOMAIN=media.fayzm.uz
MINIO_USE_HTTPS=True
# Internal address the backend uses to upload to MinIO (same Docker network).
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_INTERNAL_USE_HTTPS=False
MINIO_ROOT_USER=CHANGE-ME-minio-user
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-minio-password
MINIO_BUCKET_NAME=fayzm-media
MINIO_REGION=us-east-1

# --- Firebase (optional push) ----------------------------------------------
FIREBASE_CREDENTIALS_JSON=
FCM_SERVER_KEY=
